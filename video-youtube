<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Curso · Player YouTube</title>
  <meta name="description" content="Página leve para incorporar vídeo do YouTube e exibir dentro do Kommo via iFrame.">
  <meta name="theme-color" content="#0b1020" />
  <style>
    :root{
      --bg:#0b1020;        /* fundo geral */
      --bg2:#0a0f1f;       /* gradiente */
      --card:#0f172a;      /* cartão */
      --stroke:rgba(148,163,184,.15);
      --text:#e5e7eb;      /* texto principal */
      --muted:#94a3b8;     /* texto secundário */
      --accent:#7c3aed;    /* roxo */
      --accent2:#4f46e5;   /* azul arroxeado */
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      color:var(--text);
      background:
        radial-gradient(900px 600px at 20% -10%, #1e293b 0%, rgba(16,24,40,0) 40%),
        linear-gradient(180deg,var(--bg),var(--bg2) 65%);
      font:16px/1.6 system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Cantarell,Noto Sans,Helvetica Neue,Arial,Apple Color Emoji,Segoe UI Emoji;
    }
    .container{max-width:980px;margin:36px auto;padding:0 18px}
    .card{
      background:rgba(15,23,42,.9);
      border:1px solid var(--stroke);
      border-radius:16px;
      overflow:hidden;
      box-shadow:0 24px 80px rgba(0,0,0,.35);
      backdrop-filter: blur(6px);
    }
    .header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--stroke)}
    .title{font-weight:700;letter-spacing:.2px}
    .badge{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#1f2937,#111827);border:1px solid rgba(148,163,184,.25);padding:6px 10px;border-radius:20px;font-size:12px;color:#cbd5e1}
    .badge svg{width:14px;height:14px;opacity:.9}
    .video{position:relative;width:100%;aspect-ratio:16/9;background:#0b1220}
    .video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
    .body{padding:14px 20px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between}
    .sub{color:var(--muted);font-size:14px;margin:0}
    .cta{appearance:none;border:0;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;padding:10px 14px;border-radius:10px;font-weight:600;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease;box-shadow:0 10px 30px rgba(79,70,229,.35)}
    .cta:hover{transform:translateY(-1px);box-shadow:0 16px 40px rgba(79,70,229,.5)}
    .footer{padding:12px 20px;border-top:1px solid var(--stroke);color:#94a3b8;font-size:12px}
    @media (max-width:480px){.container{margin:18px auto}.title{font-size:16px}}
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <div class="title">Aula · Introdução (YouTube)</div>
        <span class="badge" aria-label="Vídeo incorporado">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 8l6 4-6 4V8z"></path><path d="M21 7s-.2-1.4-.8-2c-.8-.8-1.7-.8-2.1-.9C15.8 3.8 12 3.8 12 3.8s-3.8 0-6.1.3c-.4 0-1.3.1-2.1.9C3.2 5.6 3 7 3 7s-.2 1.7-.2 3.4v1.2C2.8 13.3 3 15 3 15s.2 1.4.8 2c.8.8 1.9.8 2.4.9 1.8.2 5.8.3 5.8.3s3.8 0 6.1-.3c.4 0 1.3-.1 2.1-.9.6-.6.8-2 .8-2s.2-1.7.2-3.4v-1.2C21.2 8.7 21 7 21 7z" opacity=".28"></path></svg>
          Player
        </span>
      </div>

      <div class="video" role="region" aria-label="Player do YouTube">
        <!-- Troque apenas o ID na URL abaixo, se precisar. -->
        <iframe
          src="https://www.youtube.com/embed/ZsYTy7-EA0M?modestbranding=1&rel=0&hl=pt&iv_load_policy=3&playsinline=1"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; web-share; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen>
        </iframe>
      </div>

      <div class="body">
        <p class="sub">Abra no YouTube para comentários, capítulos e qualidade máxima.</p>
        <a class="cta" href="https://youtu.be/ZsYTy7-EA0M" target="_blank" rel="noopener">Abrir no YouTube</a>
      </div>

      <div class="footer">Pronto para iFrame no Kommo (Custom Widget). Sem dependências externas.</div>
    </div>
  </div>
</body>
</html>
